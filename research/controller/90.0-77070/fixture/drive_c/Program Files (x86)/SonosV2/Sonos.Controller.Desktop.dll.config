<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="Sonos.Controller.Desktop.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <userSettings>
        <Sonos.Controller.Desktop.Properties.Settings>
            <setting name="MainWindowPlacement" serializeAs="String">
                <value />
            </setting>
            <setting name="MainWindowLeftColumnWidthInvariant" serializeAs="String">
                <value>264*</value>
            </setting>
            <setting name="MainWindowCenterColumnWidthInvariant" serializeAs="String">
                <value>322*</value>
            </setting>
            <setting name="MainWindowRightColumnWidthInvariant" serializeAs="String">
                <value>418*</value>
            </setting>
            <setting name="SettingsWindowPlacement" serializeAs="String">
                <value />
            </setting>
            <setting name="AboutWindowPlacement" serializeAs="String">
                <value />
            </setting>
            <setting name="SavedSearchTerms" serializeAs="Xml">
                <value>
                    <ArrayOfString xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                        xmlns:xsd="http://www.w3.org/2001/XMLSchema" />
                </value>
            </setting>
            <setting name="SavedSearchProvider" serializeAs="String">
                <value />
            </setting>
            <setting name="UserSelectedCulture" serializeAs="String">
                <value />
            </setting>
            <setting name="ErrorLog" serializeAs="String">
                <value />
            </setting>
            <setting name="MiniWindowPlacement" serializeAs="String">
                <value />
            </setting>
            <setting name="MiniWindowIsShowing" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="MiniWindowIsLarge" serializeAs="String">
                <value>False</value>
            </setting>
        </Sonos.Controller.Desktop.Properties.Settings>
    </userSettings>
    <log filter="Error" includeDefault="false">
        <loggers>
            <add name="fileLogger" filter="Error" data="SonosLog.xml" maxEntriesPerFile="400" maxFiles="5"/>
        </loggers>
    </log>
</configuration>